import { Business } from "@/lib/types";
import StatusBadge from "./StatusBadge";

interface Props {
  business: Business;
  isSaved: boolean;
  onSave: (business: Business) => void;
}

export default function BusinessCard({ business, isSaved, onSave }: Props) {
  return (
    <div className="flex flex-col gap-3 rounded-xl border border-fg/10 bg-white/[0.02] p-5">
      <div className="flex items-start justify-between gap-3">
        <div>
          <h3 className="text-lg font-semibold text-fg">{business.name}</h3>
          <p className="text-sm text-muted">{business.category}</p>
        </div>
        <StatusBadge status={business.websiteStatus} />
      </div>

      <p className="text-sm text-fg/80">{business.address}</p>

      <div className="flex flex-wrap gap-x-6 gap-y-1 text-sm text-muted">
        <span>{business.phone || "Phone unavailable"}</span>
        <span>
          {business.rating !== null ? `★ ${business.rating.toFixed(1)}` : "No rating"}
          {business.reviewCount !== null ? ` (${business.reviewCount} reviews)` : ""}
        </span>
      </div>

      <div className="mt-1 flex flex-wrap items-center gap-3">
        <a
          href={business.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          className="rounded-lg border border-fg/20 px-3 py-1.5 text-sm text-fg hover:border-fg/40"
        >
          Open in Google Maps
        </a>

        {business.websiteStatus === "none" && (
          <button
            onClick={() => onSave(business)}
            disabled={isSaved}
            className="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-fg transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {isSaved ? "Saved" : "Save Lead"}
          </button>
        )}
      </div>
    </div>
  );
}
