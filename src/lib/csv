import { Business } from "./types";

const HEADERS = [
  "Business Name",
  "Category",
  "Address",
  "Phone",
  "Rating",
  "Reviews",
  "Website",
  "Website Status",
  "Google Maps URL",
];

function statusLabel(status: Business["websiteStatus"]): string {
  if (status === "listed") return "Website Listed";
  if (status === "none") return "No Website Listed";
  return "Unknown";
}

function escapeCell(value: string | number | null): string {
  const str = value === null || value === undefined ? "" : String(value);
  if (/[",\n]/.test(str)) {
    return `"${str.replace(/"/g, '""')}"`;
  }
  return str;
}

export function businessesToCsv(businesses: Business[]): string {
  const rows = businesses.map((b) =>
    [
      b.name,
      b.category,
      b.address,
      b.phone || "",
      b.rating ?? "",
      b.reviewCount ?? "",
      b.website || "",
      statusLabel(b.websiteStatus),
      b.googleMapsUrl,
    ]
      .map(escapeCell)
      .join(",")
  );

  return [HEADERS.join(","), ...rows].join("\n");
}

export function downloadCsv(filename: string, csvContent: string) {
  const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}
